# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # backend only — never in frontend
SUPABASE_JWT_SECRET=                # only if the project uses the legacy HS256 secret; leave blank for JWKS
DATABASE_URL=                       # Postgres connection string. Direct db host may be IPv6-only; the session pooler form is: postgresql://postgres.<project-ref>:<pw>@<region>.pooler.supabase.com:5432/postgres?sslmode=require (pin hostaddr=<IPv4> if the network stalls on NAT64 AAAA)
FORCE_IPV4=                         # 1 = filter getaddrinfo to IPv4 in the backend process (for DNS64/NAT64 networks with dead IPv6 routes)

# Login
EMPLOYEE_EMAIL_DOMAIN=employees.kaarigar.app   # hidden login emails: <employee_id>@<plant_slug>.<domain>
SEED_ADMIN_PASSWORD=                # password for the seeded supervisor account

# App
ALLOWED_ORIGINS=http://localhost:5173,https://app.kaarigar-ai.online,https://dev.kaarigar-ai.online
APP_ENV=development
LANGUAGES_FILE=                     # optional; defaults to <repo root>/shared/languages.json

# Phase 1 — knowledge in
GROQ_API_KEY=                       # optional in Phase 1 (rules fallback); required for Phase 2
GROQ_MODEL_SMALL=openai/gpt-oss-20b
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_ENABLED=false
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
FASTEMBED_CACHE_PATH=./.cache/fastembed   # git-ignored; mount as a volume in Docker
MAX_PDF_MB=25
MAX_PDF_PAGES=300
MAX_LOG_MB=5
MAX_LOG_ROWS=5000

# Frontend (Vite reads VITE_* only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=/api                   # proxied to the backend in dev
VITE_PLANT_CODE=shree               # default plant on the phone login

# Phase 2 — capture (voice repair notes)
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=translate
GROQ_MODEL_LARGE=openai/gpt-oss-120b
MAX_RECORDING_SEC=180
MAX_AUDIO_MB=10
STT_SEGMENT_SEC=25
CAPTURE_WORKERS=2

# Phase 3 — assist + escalations
ASSIST_STT_MODE=codemix
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
GROQ_MODEL_ANSWER=openai/gpt-oss-120b
GROQ_MODEL_SMALL=openai/gpt-oss-20b
ASSIST_WORKERS=4
ASK_PER_MINUTE=10
ESCALATE_BELOW=0.5
AUDIO_CLEAN=true
MIN_SPEECH_SEC=0.4

ASSIST_MAX_AUDIO_MB=5

# Phase 4 — manager app + QR stickers
PUBLIC_APP_URL=https://app.kaarigar-ai.online    # QR stickers open PUBLIC_APP_URL/m/<qr_token>
                                                 # dev: https://dev.kaarigar-ai.online, so stickers work through the tunnel
STICKERS_MAX=60                                  # stickers per print request (5 A4 sheets)
