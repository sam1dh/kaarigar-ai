# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # backend only — never in frontend
SUPABASE_JWT_SECRET=                # only if the project uses the legacy HS256 secret; leave blank for JWKS
DATABASE_URL=                       # Postgres connection string (used from Phase 2 for LangGraph)

# Login
EMPLOYEE_EMAIL_DOMAIN=employees.kaarigar.app   # hidden login emails: <employee_id>@<plant_slug>.<domain>
SEED_ADMIN_PASSWORD=                # password for the seeded supervisor account

# App
ALLOWED_ORIGINS=http://localhost:5173
APP_ENV=development

# Frontend (Vite reads VITE_* only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=/api                   # proxied to the backend in dev
VITE_PLANT_CODE=shree               # default plant on the phone login
