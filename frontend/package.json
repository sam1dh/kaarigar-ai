{
  "name": "kaarigar-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "phone": "vite build && vite preview --host --port 4173",
    "tunnel": "cloudflared tunnel run --token $(cat ../.tunnel-token)",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "i18n:check": "node scripts/i18n-check.mjs",
    "dev:phone": "cross-env TUNNEL_DEV=1 vite"
  },
