# Frontend build settings for deploy/deploy_frontend.sh. Copy to deploy/frontend.env.production. Everything here is PUBLIC:
# it ends up in the JavaScript bundle. Only the anon/publishable key, never the service-role key.
VITE_API_URL=https://api.kaarigar-ai.online
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon / publishable key>
# default plant on the phone login
VITE_PLANT_CODE=shree
