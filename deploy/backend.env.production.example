# No quotes, no inline comments (Docker's --env-file would keep them as part of the value).
# Use a database password of letters and digits only (Supabase → Database → Reset password) so nothing needs escaping.
# Backend production settings. Copy to deploy/.env.production (git-ignored) and fill in.
# deploy/deploy_backend.sh turns the secret ones into Azure Container Apps secrets. Never put these in VITE_* variables.
# hides /dev/* routes
APP_ENV=production
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=<anon / publishable key>
# backend only. Rotate if it ever leaks.
SUPABASE_SERVICE_ROLE_KEY=<service-role key>
# only for the legacy HS256 secret; blank = JWKS
SUPABASE_JWT_SECRET=
DATABASE_URL=postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# ^ Supabase → Connect → "Session pooler" (IPv4, port 5432). NOT db.<project>.supabase.co (IPv6 only: Azure can't reach it)
#   and not :6543 (transaction mode breaks prepared statements).
GROQ_API_KEY=<key>
SARVAM_API_KEY=<key>

# Phase 6 fallbacks. Leave a key as PASTE_... to disable that provider.
# LLM order: Groq 120b -> Groq 20b -> Mistral -> Gemini -> OpenRouter (only if set).
MISTRAL_API_KEY=PASTE_MISTRAL_KEY
MISTRAL_MODEL=mistral-small-latest
GEMINI_API_KEY=PASTE_GEMINI_KEY
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=PASTE_OPENROUTER_KEY
OPENROUTER_MODEL=openai/gpt-oss-120b
# STT order: Sarvam -> Groq Whisper -> Azure Speech -> Deepgram (only if set).
# TTS order: Sarvam Bulbul -> Azure neural voice -> browser speechSynthesis.
AZURE_SPEECH_KEY=PASTE_AZURE_SPEECH_KEY
AZURE_SPEECH_REGION=centralindia
DEEPGRAM_API_KEY=PASTE_DEEPGRAM_KEY
GROQ_STT_MODEL=whisper-large-v3
# Set only for a fallback drill, e.g. DISABLE_PROVIDERS=groq. Remove after the drill.
DISABLE_PROVIDERS=
LLM_TIMEOUT_SEC=8
PROVIDER_BREAKER_FAILURES=3
PROVIDER_BREAKER_COOLDOWN_SEC=60

# URLs
# printed inside every QR sticker. Change = reprint stickers.
PUBLIC_APP_URL=https://app.kaarigar-ai.online
ALLOWED_ORIGINS=https://app.kaarigar-ai.online
# must match Phase 0's hidden-email domain
EMPLOYEE_EMAIL_DOMAIN=employees.kaarigar.app

# Models (same as development)
EMBED_MODEL=BAAI/bge-small-en-v1.5
GROQ_MODEL_ANSWER=openai/gpt-oss-120b
GROQ_MODEL_SMALL=openai/gpt-oss-20b
# token saving (Phase 6): shorter answers, 4 sources, smaller prompt
ANSWER_MAX_TOKENS=700
CONTEXT_K=4
SOURCE_CHARS=700
MIN_SCORE_RATIO=0.35
ANSWER_CACHE=true
ANSWER_CACHE_TTL_DAYS=7
RERANK_ENABLED=false
# baked into the image
FASTEMBED_CACHE_PATH=/app/.cache/fastembed

# Limits
ASSIST_WORKERS=4
ASK_PER_MINUTE=10
TTS_PER_MINUTE=20
STICKERS_MAX=60
MAX_PDF_MB=25
MAX_PDF_PAGES=300
MAX_LOG_MB=5
MAX_LOG_ROWS=5000
LOG_LEVEL=INFO
